            "label": "3年",
            "value": "3"
          },
          {
            "label": "5年",
            "value": "5"
          },
          {
            "label": "10年",
            "value": "10"
          }
        ]
      },
      {
        "key": "wacc",
        "label": "折现率 (WACC)",
        "type": "select",
        "defaultValue": "10",
        "options": [
          {
            "label": "8%",
            "value": "8"
          },
          {
            "label": "10%",
            "value": "10"
          },
          {
            "label": "12%",
            "value": "12"
          },
          {
            "label": "自定义",
            "value": "custom"
          }
        ]
      },
      {
        "key": "waccCustom",
        "label": "自定义 WACC",
        "type": "number",
        "unit": "%",
        "placeholder": "输入自定义折现率",
        "dependsOn": {
          "key": "wacc",
          "value": "custom"
        }
      },
      {
        "key": "terminalMethod",
        "label": "终值方法",
        "type": "select",
        "defaultValue": "perpetuity",
        "options": [
          {
            "label": "永续增长法",
            "value": "perpetuity"
          },
          {
            "label": "退出倍数法",
            "value": "exit-multiple"
          }
        ]
      },
      {
        "key": "terminalGrowth",
        "label": "永续增长率",
        "type": "number",
        "unit": "%",
        "defaultValue": 2.5,
        "dependsOn": {
          "key": "terminalMethod",
          "value": "perpetuity"
